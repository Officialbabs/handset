[Desktop Entry]
Version=1.0
Type=Application
Name=Handset
GenericName=Phone Mirror
Comment=Your phone's screen in a window, shared with Ada
Exec=@EXEC@
Icon=io.github.Officialbabs.Handset
Terminal=false
Categories=Utility;
Keywords=phone;mirror;android;iphone;screen;pixel;
StartupWMClass=io.github.Officialbabs.Handset
StartupNotify=true
SingleMainWindow=true
Actions=new-window;phones;off;
# A switch in Ada's Control Center: on while Handset is (it keeps handset.on in the runtime
# folder); switching it on starts Handset, off runs the Turn Off action.
X-Ada-ControlCenter=toggle
X-Ada-ControlCenter-State=handset.on
X-Ada-ControlCenter-Name=Handset

[Desktop Action new-window]
Name=New Window
Exec=@EXEC@ --new-window

[Desktop Action phones]
Name=Phones and Settings
Exec=@EXEC@ --phones

[Desktop Action off]
Name=Turn Off
Exec=@EXEC@ --off
